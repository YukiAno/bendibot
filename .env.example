# ============================================================
#  bendibot 配置模板
#  复制成 .env 后填入你自己的值。**不要把真实 .env 提交到仓库**。
# ============================================================

# ============================================================
#  bendibot 配置文件
#
#  ⚠ 本文件包含 API 密钥与连接令牌，已在 .gitignore 中排除。
#     请勿提交到 git、勿截图分享、勿粘贴到任何聊天窗口或 Issue。
# ============================================================

# ---------------- NoneBot2 基础 ----------------
DRIVER=<your-driver>
HOST=<your-host>
PORT=8080
LOG_LEVEL=<your-log-level>

# 插件数据目录改为基于项目目录（会生成 ./data、./config、./cache）
# 这样做的好处：对话记忆等数据集中在项目内，不散落到系统用户目录，
# 且这几个目录已被 .gitignore 排除，不会误提交（聊天记录不外泄）。
LOCALSTORE_USE_CWD=true

# 指令前缀：同时支持 "/API预设" 和直接发 "API预设"
COMMAND_START=<your-command-start>

# 机器人昵称（llmchat 要求此项必填）
NICKNAME=<your-nickname>

# ---------------- NapCat <-> 本框架 连接令牌 ----------------
# 已为你随机生成（48 位十六进制）。
# 请把下面这串原样填到 NapCat WebUI 的网络配置 token 处，两边必须完全一致。
ONEBOT_ACCESS_TOKEN=<your-onebot-access-token>

# ---------------- LLM 配置（DeepSeek 官方）----------------
# ★★★ 这是整个文件中唯一需要你手动修改的地方 ★★★
#
# 把下面 JSON 里的  sk-替换成你的密钥  换成你自己的 DeepSeek API Key 后保存即可。
#   · 密钥形如 sk-xxxxxxxxxxxxxxxxxxxxxxxx
#   · 填的时候不要带引号、前后不要留空格
#   · 获取 / 充值地址：https://platform.deepseek.com/api_keys
#   · 注意：账户余额为 0 时对话会直接失败（报 Insufficient Balance）
#
LLMCHAT__API_PRESETS=<your-llmchat--api-presets>

# 默认启用的预设名。
# 若改为 off（或删掉此行）= 插件默认关闭，需要在群里发「API预设 deepseek」手动开启。
LLMCHAT__DEFAULT_PRESET=<your-llmchat--default-preset>

# ---------------- 上下文与调用行为 ----------------
# 数值越大越费 token（= 越费钱），先保守设置，群里稳定后再逐步放大
LLMCHAT__HISTORY_SIZE=10
LLMCHAT__PAST_EVENTS_SIZE=6
LLMCHAT__MAX_TOOL_ROUNDS=8
LLMCHAT__REQUEST_TIMEOUT=60

# 随机主动插话概率，范围 [0,1]。0 = 完全不主动插话，只在被 @ 时回复。
#
# ★★ 2026-10-25 已设为 0 ★★
#   原来这里是 0.03（3%）。意思是群里每来一条消息，bot 都有 3% 概率
#   主动开口 —— 这是「没有任何触发的自发发言」，QQ 风控对它最敏感。
#   群越活跃发得越多，而且群里越热闹它越容易踩线。
#
#   想恢复主动插话就改回一个小值（建议不超过 0.005），
#   但要知道：这是那次风控的成因之一。
LLMCHAT__RANDOM_TRIGGER_PROB=0

# ---------------- 人格设定 ----------------
# 可随时直接改这里；也可在群里用「修改设定」按群单独改
LLMCHAT__DEFAULT_PROMPT=<your-llmchat--default-prompt>

# ---------------- 私聊 ----------------
#
#   注意：私聊和群聊的触发规则不一样 ——
#   群里要 @ 才回，私聊是你说一句它回一句（llmchat 里
#   `if not is_group: return True`）。所以别连着发一大串测试，
#   那等于自己给自己制造高频。闸门对私聊也有配额：
#   SEND_GUARD_PRIVATE_PER_MINUTE（默认 15 条/分钟）。
LLMCHAT__ENABLE_PRIVATE_CHAT=false
LLMCHAT__PRIVATE_CHAT_PRESET=<your-llmchat--private-chat-preset>







# 超级用户：可以用全部管理指令（API预设 / 修改设定 / 记忆清除 等）
SUPERUSERS=<your-superusers>

# ================= PJSK（世界计划）插件 =================
# 默认区服：cn 国服 / jp 日服 / tw 台服 / kr 韩服 / en 国际服
# 指令里也可以临时指定，例如「查活动 日服」
PJSK_DEFAULT_REGION=<your-pjsk-default-region>
PJSK_HTTP_TIMEOUT=45

# 让 AI也能自己查 PJSK 数据。原理是启动一个 MCP 子进程，
# 把「查活动 / 查榜线 / 搜歌 / 查卡 / 算实效」暴露成 AI 可调用的工具。
# ★ 改这一行之后必须重启机器人才生效。
# ★ 不需要的话，把下面这行整行删掉或前面加 # 即可（固定指令不受影响）。
LLMCHAT__MCP_SERVERS=<your-llmchat--mcp-servers>

# ================= 拟人化回复延迟（plugins/llmchat_delay.py） =================
# 总开关：false 则完全恢复 llmchat 原本的行为
REPLY_DELAY_ENABLE=true
#
# 短消息（字数 <= 分界）在下面区间内随机：
REPLY_DELAY_SHORT_MIN=2
REPLY_DELAY_SHORT_MAX=4
#
# 长消息（字数 > 分界）：基础区间随机，再按超出的字数加成 —— 越长等越久
REPLY_DELAY_THRESHOLD=12
REPLY_DELAY_LONG_MIN=3
REPLY_DELAY_LONG_MAX=5
# 超出分界后每多 1 字加多少秒（0.1 = 每字 0.1 秒）
REPLY_DELAY_LONG_PER_CHAR=0.1
# 单条延迟总上限（秒），防止长回复等太久
REPLY_DELAY_CEILING=15


# ═══════════════════════════════════════════════════════════════
#  风控防护（由 plugins/send_guard.py 读取，热生效，改完不用重启）
#
# ═══════════════════════════════════════════════════════════════

# 总开关（false = 完全不限流，回到出事前的状态，不建议）
SEND_GUARD_ENABLE=true

# ★★ 完全静默 ★★
# true = bot 照常在线、照常收消息，但一条消息都不发出去。
# 账号被风控后「静养」时用它：保持在线，又完全不产生发送行为。
SEND_GUARD_SILENT=false

# 每个群每分钟最多发几条（分条风格一次回复可能占好几条）
SEND_GUARD_GROUP_PER_MINUTE=10

# 每个群每小时最多发几条
SEND_GUARD_GROUP_PER_HOUR=120

# 全局每分钟最多发几条（防止几个群同时刷）
SEND_GUARD_GLOBAL_PER_MINUTE=20

# ★ 熔断线：某群一分钟内被「拦下」多少次就判定为有人在刷，直接静音。
#
#  注意是**被拦次数**，不是"发送次数"也不是"尝试次数" ——
#  正常群友问满配额后顶多再试一两次就停了（被拦 1~2 次），
#  只有真的在刷的人才会一直试、被拦数一路涨上去。
#
#  所以这个值要**明显大于**「每分钟上限」，别让话多的人被误伤。
SEND_GUARD_MUTE_THRESHOLD=10

# 熔断后静音多少秒
SEND_GUARD_MUTE_SECONDS=600

# 私聊每分钟上限
SEND_GUARD_PRIVATE_PER_MINUTE=15

# ===== 群白名单（只回这几个群；为空 = 所有群都不回复）=====
# 逗号分隔群号，例如：GROUP_WHITELIST=123456789,987654321
# 改完 5 秒内自动生效，不用重启。私聊不受影响。
GROUP_WHITELIST_ENABLE=true
GROUP_WHITELIST=
